{
  "manifest_version": 3,
  "name": "Bookmark-Tab Title",
  "version": "0.1.0",
  "description": "Shows the name of your bookmark as the tab title whenever a bookmarked page is open.",
  "minimum_chrome_version": "111",
  "permissions": ["bookmarks", "webNavigation", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
